# Backend Server-Only Mapbox Key (Never prefix with VITE_ to keep your key secure)
MAPBOX_API_KEY='your_mapbox_token_here'
# Backend Server-Only Google API Key (Never prefix with VITE_ to keep your key secure)
GOOGLE_API_KEY='your_google_api_key_here'


# Backend Server-Only AI Key (Never prefix with VITE_ to keep your key secure)
AI_API_KEY='your_openai_or_gemini_api_key_here'
AI_PROVIDER='openai'
AI_MODEL='gpt-4o-mini'

# Optional Gemini fallback model, available to the same API project.
# AI_FALLBACK_MODEL=your_accessible_backup_model
