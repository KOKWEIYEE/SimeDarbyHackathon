VITE_MAPBOX_API_KEY='your_mapbox_token_here'

# Optional server token for Directions; defaults to VITE_MAPBOX_API_KEY.
# Set separately if the browser token has website URL restrictions.
MAPBOX_API_KEY=

# Server-only: never prefix the Gemini key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Server-only Open-Elevation key (optional for public quota).
OPEN_ELEVATION_API=
